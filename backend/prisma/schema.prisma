model AttendanceDiscrepancy {
  id                        String   @id @default(uuid()) @db.Uuid
  studentProfileId          String   @map("student_profile_id") @db.Uuid
  attendanceRecordId        String?  @map("attendance_record_id") @db.Uuid
  assessmentAttendanceId    String?  @map("assessment_attendance_id") @db.Uuid
  attendanceAttemptId       String?  @map("attendance_attempt_id") @db.Uuid
  assignedLecturerProfileId String?  @map("assigned_lecturer_profile_id") @db.Uuid
  description               String
  status                    String
  resolution                String?
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  submittedByUserId         String?   @map("submitted_by_user_id") @db.Uuid
  submitterType             String?   @map("submitter_type")
  missingMarkReportId       String?   @map("missing_mark_report_id") @db.Uuid
  lecturerReviewedByProfileId String? @map("lecturer_reviewed_by_profile_id") @db.Uuid
  lecturerReviewedAt        DateTime? @map("lecturer_reviewed_at")

  student           StudentProfile                 @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  attendanceRecord  AttendanceRecord?              @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  assessmentRecord  AssessmentAttendance?          @relation(fields: [assessmentAttendanceId], references: [id], onDelete: Restrict)
  attendanceAttempt AttendanceAttempt?             @relation(fields: [attendanceAttemptId], references: [id], onDelete: Restrict)
  assignedLecturer  LecturerProfile?               @relation("DiscrepancyReviewer", fields: [assignedLecturerProfileId], references: [id], onDelete: Restrict)
  comments          AttendanceDiscrepancyComment[]
  decisions         AttendanceDiscrepancyDecision[]
  missingMarkReport MissingMarkReport? @relation(fields: [missingMarkReportId], references: [id], onDelete: Restrict)
  reporter          User? @relation("DiscrepancyReporter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  lecturerReviewer  LecturerProfile? @relation("DiscrepancyLecturerReviewer", fields: [lecturerReviewedByProfileId], references: [id], onDelete: Restrict)

  @@index([studentProfileId, status])
  @@index([assignedLecturerProfileId, status])
  @@index([submittedByUserId])
  @@index([missingMarkReportId])
  @@index([lecturerReviewedByProfileId, lecturerReviewedAt], map: "attendance_discrepancies_lecturer_review_idx")
  @@map("attendance_discrepancies")
}

model AttendanceDiscrepancyComment {
  id            String   @id @default(uuid()) @db.Uuid
  discrepancyId String   @map("discrepancy_id") @db.Uuid
  authorUserId  String   @map("author_user_id") @db.Uuid
    clarificationDecisionId String? @map("clarification_decision_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at")

  discrepancy AttendanceDiscrepancy @relation(fields: [discrepancyId], references: [id], onDelete: Restrict)
  author      User                  @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
    clarificationDecision AttendanceDiscrepancyDecision? @relation("ClarificationDecisionResponses", fields: [clarificationDecisionId], references: [id], onDelete: Restrict)

  @@index([discrepancyId, createdAt])
    @@index([clarificationDecisionId])
  @@unique([clarificationDecisionId, authorUserId], map: "attendance_discrepancy_comments_clarification_author_key")
  @@map("attendance_discrepancy_comments")
}

model AttendanceDiscrepancyDecision {
  id            String   @id @default(uuid()) @db.Uuid
  discrepancyId String   @map("discrepancy_id") @db.Uuid
  actorUserId   String   @map("actor_user_id") @db.Uuid
  decision      String
  explanation   String
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  sourceStatusAtAuthorization String? @map("source_status_at_authorization")
  sourceTypeAtAuthorization String? @map("source_type_at_authorization")
  sourceIdAtAuthorization String? @map("source_id_at_authorization") @db.Uuid
  revalidatesDecisionId String? @unique(map: "attendance_discrepancy_decisions_revalidates_decision_id_key") @map("revalidates_decision_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  discrepancy AttendanceDiscrepancy @relation(fields: [discrepancyId], references: [id], onDelete: Restrict)
  actor       User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  revalidates AttendanceDiscrepancyDecision? @relation("LegacyAuthorizationRevalidation", fields: [revalidatesDecisionId], references: [id], onDelete: Restrict)
  revalidations AttendanceDiscrepancyDecision[] @relation("LegacyAuthorizationRevalidation")
    clarificationResponses AttendanceDiscrepancyComment[] @relation("ClarificationDecisionResponses")
  attendanceCorrection AttendanceCorrection?

  @@index([discrepancyId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("attendance_discrepancy_decisions")
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String?  @map("display_name")
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                         UserRole[]
  studentProfile                StudentProfile?
  lecturerProfile               LecturerProfile?
  departmentMemberships         DepartmentMembership[]
  notifications                 Notification[]
  auditLogs                     AuditLog[]                     @relation("AuditActor")
  reportComments                ReportComment[]                @relation("ReportCommentAuthor")
  reportAssignments             ReportAssignment[]             @relation("ReportAssignmentActor")
  reportStatusChanges           ReportStatusHistory[]          @relation("ReportStatusActor")
  createdAssessments            Assessment[]                   @relation("AssessmentCreator")
  uploadedEvidence              SpecialCaseEvidence[]          @relation("EvidenceUploader")
  updatedSettings               SystemSetting[]                @relation("SettingUpdater")
  attendanceDiscrepancyComments AttendanceDiscrepancyComment[]
  reviewedMarkCorrections       MarkCorrection[]               @relation("MarkCorrectionReviewer")
  reportEligibilities           ReportEligibility[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model StudentProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  studentNumber     String   @unique @map("student_number")
  officialEmail     String?  @map("official_email")
  notificationEmail String?  @map("notification_email")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user                    User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollments             UnitEnrollment[]
  reports                 MissingMarkReport[]
  appeals                 Appeal[]
  attendance              AttendanceRecord[]
  attendanceHistory       AttendanceHistory[]
  attendanceAttempts      AttendanceAttempt[]
  assessmentAttendances   AssessmentAttendance[]
  catSubmissions          CatSubmission[]
  attendanceDiscrepancies AttendanceDiscrepancy[]
  excuseRequests          AttendanceExcuseRequest[]

  @@map("student_profiles")
}

model LecturerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  staffNumber String?  @unique @map("staff_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                      User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  unitAssignments           CourseUnitLecturer[]
  assignedReports           MissingMarkReport[]       @relation("AssignedLecturer")
  attendanceSessions        AttendanceSession[]
  verifiedCatSubmissions    CatSubmission[]           @relation("CatVerifier")
  attendanceCorrections     AttendanceCorrection[]    @relation("CorrectionActor")
  assignedDiscrepancies     AttendanceDiscrepancy[]   @relation("DiscrepancyReviewer")
  previousReportAssignments ReportAssignment[]        @relation("PreviousReportLecturer")
  newReportAssignments      ReportAssignment[]        @relation("NewReportLecturer")
  proposedMarkCorrections   MarkCorrection[]          @relation("MarkCorrectionProposer")
  reviewedExcuseRequests    AttendanceExcuseRequest[] @relation("ExcuseReviewer")

  @@map("lecturer_profiles")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  courseUnits CourseUnit[]
  members     DepartmentMembership[]

  @@map("departments")
}

model DepartmentMembership {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@map("department_memberships")
}

model CourseUnit {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  code         String
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department         Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  enrollments        UnitEnrollment[]
  lecturerMappings   CourseUnitLecturer[]
  reports            MissingMarkReport[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]

  @@unique([departmentId, code])
  @@index([code])
  @@map("course_units")
}

model AcademicPeriod {
  id        String    @id @default(uuid()) @db.Uuid
  code      String?   @unique
  name      String
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")

  enrollments UnitEnrollment[]
  reports     MissingMarkReport[]

  @@index([name])
  @@map("academic_periods")
}

model UnitEnrollment {
  id               String   @id @default(uuid()) @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  courseUnitId     String   @map("course_unit_id") @db.Uuid
  academicPeriodId String   @map("academic_period_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  student        StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  courseUnit     CourseUnit     @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, courseUnitId, academicPeriodId])
  @@index([courseUnitId, academicPeriodId])
  @@map("unit_enrollments")
}

model CourseUnitLecturer {
  id                String   @id @default(uuid()) @db.Uuid
  courseUnitId      String   @map("course_unit_id") @db.Uuid
  lecturerProfileId String   @map("lecturer_profile_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  courseUnit CourseUnit      @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  lecturer   LecturerProfile @relation(fields: [lecturerProfileId], references: [id], onDelete: Restrict)

  @@unique([courseUnitId, lecturerProfileId])
  @@index([lecturerProfileId])
  @@map("course_unit_lecturers")
}

model MissingMarkReport {
  id                        String    @id @default(uuid()) @db.Uuid
  reference                 String    @unique
  studentProfileId          String    @map("student_profile_id") @db.Uuid
  courseUnitId              String    @map("course_unit_id") @db.Uuid
  academicPeriodId          String    @map("academic_period_id") @db.Uuid
  assessmentId              String?   @map("assessment_id") @db.Uuid
  assignedLecturerProfileId String?   @map("assigned_lecturer_profile_id") @db.Uuid
  assessmentComponent       String    @map("assessment_component")
  description               String
  status                    String
  submittedAt               DateTime? @map("submitted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  student           StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  courseUnit        CourseUnit            @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  academicPeriod    AcademicPeriod        @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  assignedLecturer  LecturerProfile?      @relation("AssignedLecturer", fields: [assignedLecturerProfileId], references: [id], onDelete: Restrict)
  appeals           Appeal[]
  assessment        Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  comments          ReportComment[]
  assignments       ReportAssignment[]
  statusHistory     ReportStatusHistory[]
  specialCase       SpecialCase?
  evidence          SpecialCaseEvidence[]
  notifications     Notification[]
  eligibilityChecks ReportEligibility[]
  markCorrections   MarkCorrection[]

  @@index([studentProfileId, status])
  @@index([assignedLecturerProfileId, status])
  @@index([courseUnitId, academicPeriodId])
  @@index([assessmentId])
  @@map("missing_mark_reports")
}

model AttendanceSession {
  id                String    @id @default(uuid()) @db.Uuid
  courseUnitId      String    @map("course_unit_id") @db.Uuid
  lecturerProfileId String    @map("lecturer_profile_id") @db.Uuid
  classroomId       String?   @map("classroom_id") @db.Uuid
  assessmentId      String?   @map("assessment_id") @db.Uuid
  accessTokenHash   String?   @unique @map("access_token_hash")
  status            String    @default("scheduled")
  startsAt          DateTime  @map("starts_at")
  endsAt            DateTime? @map("ends_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  courseUnit CourseUnit          @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  lecturer   LecturerProfile     @relation(fields: [lecturerProfileId], references: [id], onDelete: Restrict)
  records    AttendanceRecord[]
  classroom  Classroom?          @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  assessment Assessment?         @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  attempts   AttendanceAttempt[]

  @@index([courseUnitId, startsAt])
  @@index([lecturerProfileId])
  @@index([assessmentId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  status           String
  locationVerified Boolean  @default(false) @map("location_verified")
  recordedAt       DateTime @default(now()) @map("recorded_at")
  createdAt        DateTime @default(now()) @map("created_at")

  session        AttendanceSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student        StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  history        AttendanceHistory?
  corrections    AttendanceCorrection[]
  discrepancies  AttendanceDiscrepancy[]
  excuseRequests AttendanceExcuseRequest[]

  @@unique([sessionId, studentProfileId])
  @@index([studentProfileId, recordedAt])
  @@map("attendance_records")
}

model Appeal {
  id               String   @id @default(uuid()) @db.Uuid
  reportId         String   @map("report_id") @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  reason           String
  status           String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  comments         String?

  report   MissingMarkReport     @relation(fields: [reportId], references: [id], onDelete: Restrict)
  student  StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  evidence SpecialCaseEvidence[]

  @@index([reportId, createdAt])
  @@index([studentProfileId])
  @@map("appeals")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  reportId  String?   @map("report_id") @db.Uuid
  title     String
  message   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  report MissingMarkReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([reportId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Assessment {
  id                     String    @id @default(uuid()) @db.Uuid
  courseUnitId           String    @map("course_unit_id") @db.Uuid
  createdByUserId        String?   @map("created_by_user_id") @db.Uuid
  code                   String?
  name                   String
  type                   String
  assessmentDate         DateTime? @map("assessment_date")
  maximumMarks           Decimal?  @map("maximum_marks") @db.Decimal(8, 2)
  requiredForEligibility Boolean   @default(false) @map("required_for_eligibility")
  attendanceRequired     Boolean   @default(false) @map("attendance_required")
  submissionRequired     Boolean   @default(false) @map("submission_required")
  qrReferenceHash        String?   @unique @map("qr_reference_hash")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  courseUnit        CourseUnit             @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  createdBy         User?                  @relation("AssessmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reports           MissingMarkReport[]
  sessions          AttendanceSession[]
  attendanceRecords AssessmentAttendance[]
  catSubmissions    CatSubmission[]

  @@unique([courseUnitId, code])
  @@index([courseUnitId, type])
  @@map("assessments")
}

model Classroom {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  boundaryMeters Int      @map("boundary_meters")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sessions AttendanceSession[]

  @@unique([name])
  @@map("classrooms")
}

model AttendanceAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  outcome          String
  failureReason    String?  @map("failure_reason")
  occurredAt       DateTime @default(now()) @map("occurred_at")

  session       AttendanceSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student       StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  discrepancies AttendanceDiscrepancy[]

  @@index([sessionId, occurredAt])
  @@index([studentProfileId, occurredAt])
  @@map("attendance_attempts")
}

model AttendanceHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  attendanceRecordId String?  @unique @map("attendance_record_id") @db.Uuid
  studentProfileId   String   @map("student_profile_id") @db.Uuid
  courseUnitCode     String   @map("course_unit_code")
  courseUnitName     String   @map("course_unit_name")
  sessionStartedAt   DateTime @map("session_started_at")
  status             String
  locationVerified   Boolean  @map("location_verified")
  signedAt           DateTime @map("signed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  student          StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@index([studentProfileId, signedAt])
  @@map("attendance_history")
}

model AttendanceCorrection {
  id                 String   @id @default(uuid()) @db.Uuid
  attendanceRecordId String   @map("attendance_record_id") @db.Uuid
  lecturerProfileId  String   @map("lecturer_profile_id") @db.Uuid
  originalStatus     String   @map("original_status")
  correctedStatus    String   @map("corrected_status")
  reason             String
  createdAt          DateTime @default(now()) @map("created_at")

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  lecturer         LecturerProfile  @relation("CorrectionActor", fields: [lecturerProfileId], references: [id], onDelete: Restrict)

  @@index([attendanceRecordId, createdAt])
  @@map("attendance_corrections")
}

model AssessmentAttendance {
  id               String   @id @default(uuid()) @db.Uuid
  assessmentId     String   @map("assessment_id") @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  status           String
  recordedAt       DateTime @default(now()) @map("recorded_at")
  createdAt        DateTime @default(now()) @map("created_at")

  assessment    Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student       StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  discrepancies AttendanceDiscrepancy[]

  @@unique([assessmentId, studentProfileId])
  @@index([studentProfileId, recordedAt])
  @@map("assessment_attendance")
}

model CatSubmission {
  id                   String    @id @default(uuid()) @db.Uuid
  assessmentId         String    @map("assessment_id") @db.Uuid
  studentProfileId     String    @map("student_profile_id") @db.Uuid
  confirmedAt          DateTime? @map("confirmed_at")
  verifiedByLecturerId String?   @map("verified_by_lecturer_id") @db.Uuid
  verifiedAt           DateTime? @map("verified_at")
  comments             String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  verifiedBy LecturerProfile? @relation("CatVerifier", fields: [verifiedByLecturerId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, studentProfileId])
  @@index([verifiedByLecturerId, verifiedAt])
  @@map("cat_submissions")
}

model SpecialCase {
  id          String   @id @default(uuid()) @db.Uuid
  reportId    String   @unique @map("report_id") @db.Uuid
  category    String
  description String
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  report   MissingMarkReport     @relation(fields: [reportId], references: [id], onDelete: Restrict)
  evidence SpecialCaseEvidence[]

  @@map("special_cases")
}

model SpecialCaseEvidence {
  id               String   @id @default(uuid()) @db.Uuid
  reportId         String   @map("report_id") @db.Uuid
  appealId         String?  @map("appeal_id") @db.Uuid
  specialCaseId    String?  @map("special_case_id") @db.Uuid
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  originalName     String   @map("original_name")
  storageKey       String   @unique @map("storage_key")
  mediaType        String   @map("media_type")
  sizeBytes        Int      @map("size_bytes")
  createdAt        DateTime @default(now()) @map("created_at")

  report      MissingMarkReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  appeal      Appeal?           @relation(fields: [appealId], references: [id], onDelete: Restrict)
  specialCase SpecialCase?      @relation(fields: [specialCaseId], references: [id], onDelete: Restrict)
  uploadedBy  User              @relation("EvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([appealId])
  @@index([specialCaseId])
  @@map("special_case_evidence")
}

model AttendanceDiscrepancy {
  id                        String   @id @default(uuid()) @db.Uuid
  studentProfileId          String   @map("student_profile_id") @db.Uuid
  attendanceRecordId        String?  @map("attendance_record_id") @db.Uuid
  assessmentAttendanceId    String?  @map("assessment_attendance_id") @db.Uuid
  attendanceAttemptId       String?  @map("attendance_attempt_id") @db.Uuid
  assignedLecturerProfileId String?  @map("assigned_lecturer_profile_id") @db.Uuid
  description               String
  status                    String
  resolution                String?
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  student           StudentProfile                 @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  attendanceRecord  AttendanceRecord?              @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  assessmentRecord  AssessmentAttendance?          @relation(fields: [assessmentAttendanceId], references: [id], onDelete: Restrict)
  attendanceAttempt AttendanceAttempt?             @relation(fields: [attendanceAttemptId], references: [id], onDelete: Restrict)
  assignedLecturer  LecturerProfile?               @relation("DiscrepancyReviewer", fields: [assignedLecturerProfileId], references: [id], onDelete: Restrict)
  comments          AttendanceDiscrepancyComment[]

  @@index([studentProfileId, status])
  @@index([assignedLecturerProfileId, status])
  @@map("attendance_discrepancies")
}

model AttendanceDiscrepancyComment {
  id            String   @id @default(uuid()) @db.Uuid
  discrepancyId String   @map("discrepancy_id") @db.Uuid
  authorUserId  String   @map("author_user_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at")

  discrepancy AttendanceDiscrepancy @relation(fields: [discrepancyId], references: [id], onDelete: Restrict)
  author      User                  @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([discrepancyId, createdAt])
  @@map("attendance_discrepancy_comments")
}

model ReportComment {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  isStudentVisible Boolean @default(false) @map("is_student_visible")
  createdAt    DateTime @default(now()) @map("created_at")

  report MissingMarkReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  author User              @relation("ReportCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("report_comments")
}

model ReportAssignment {
  id                        String   @id @default(uuid()) @db.Uuid
  reportId                  String   @map("report_id") @db.Uuid
  actorUserId               String   @map("actor_user_id") @db.Uuid
  previousLecturerProfileId String?  @map("previous_lecturer_profile_id") @db.Uuid
  newLecturerProfileId      String   @map("new_lecturer_profile_id") @db.Uuid
  reason                    String?
  createdAt                 DateTime @default(now()) @map("created_at")

  report           MissingMarkReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  actor            User              @relation("ReportAssignmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  previousLecturer LecturerProfile?  @relation("PreviousReportLecturer", fields: [previousLecturerProfileId], references: [id], onDelete: Restrict)
  newLecturer      LecturerProfile   @relation("NewReportLecturer", fields: [newLecturerProfileId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([newLecturerProfileId, createdAt])
  @@map("report_assignments")
}

model ReportStatusHistory {
  id             String   @id @default(uuid()) @db.Uuid
  reportId       String   @map("report_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  report MissingMarkReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  actor  User?             @relation("ReportStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@map("report_status_history")
}

model SystemSetting {
  key             String   @id
  value           Json
  description     String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("SettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model AttendanceExcuseRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  attendanceRecordId   String    @map("attendance_record_id") @db.Uuid
  studentProfileId     String    @map("student_profile_id") @db.Uuid
  reviewedByLecturerId String?   @map("reviewed_by_lecturer_id") @db.Uuid
  reason               String
  status               String
  decisionReason       String?   @map("decision_reason")
  reviewedAt           DateTime? @map("reviewed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  student          StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  reviewedBy       LecturerProfile? @relation("ExcuseReviewer", fields: [reviewedByLecturerId], references: [id], onDelete: Restrict)

  @@index([studentProfileId, status])
  @@index([reviewedByLecturerId, status])
  @@map("attendance_excuse_requests")
}

model ReportEligibility {
  id                            String   @id @default(uuid()) @db.Uuid
  reportId                      String   @map("report_id") @db.Uuid
  checkedByUserId               String?  @map("checked_by_user_id") @db.Uuid
  classification                String
  attendancePercentage          Decimal? @map("attendance_percentage") @db.Decimal(5, 2)
  classAttendanceEligible       Boolean? @map("class_attendance_eligible")
  catAttendanceEligible         Boolean? @map("cat_attendance_eligible")
  examinationAttendanceEligible Boolean? @map("examination_attendance_eligible")
  details                       Json?
  checkedAt                     DateTime @default(now()) @map("checked_at")

  report    MissingMarkReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  checkedBy User?             @relation(fields: [checkedByUserId], references: [id], onDelete: SetNull)

  @@index([reportId, checkedAt])
  @@map("report_eligibility")
}

model MarkCorrection {
  id                   String    @id @default(uuid()) @db.Uuid
  reportId             String    @map("report_id") @db.Uuid
  proposedByLecturerId String    @map("proposed_by_lecturer_id") @db.Uuid
  reviewedByUserId     String?   @map("reviewed_by_user_id") @db.Uuid
  originalValue        Decimal?  @map("original_value") @db.Decimal(8, 2)
  proposedValue        Decimal   @map("proposed_value") @db.Decimal(8, 2)
  finalValue           Decimal?  @map("final_value") @db.Decimal(8, 2)
  status               String
  reason               String?
  reviewComments       String?   @map("review_comments")
  decidedAt            DateTime? @map("decided_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  report     MissingMarkReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  proposedBy LecturerProfile   @relation("MarkCorrectionProposer", fields: [proposedByLecturerId], references: [id], onDelete: Restrict)
  reviewedBy User?             @relation("MarkCorrectionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([reviewedByUserId, status])
  @@map("mark_corrections")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoginIdentifierType {
  STUDENT_NUMBER
  STAFF_NUMBER
  ADMIN_NUMBER
}

enum AccountSecurityTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum StudentEnrollmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DepartmentMembershipRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  pendingEmail String?  @unique @map("pending_email")
  avatarData   String?  @map("avatar_data") @db.Text
  displayName  String?  @map("display_name")
  passwordHash String   @map("password_hash")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  sessionVersion Int    @default(0) @map("session_version")
  isActive     Boolean  @default(true) @map("is_active")
  approvalStatus AccountApprovalStatus @default(APPROVED) @map("approval_status")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                         UserRole[]
  loginIdentifiers              AccountLoginIdentifier[]
  securityTokens                AccountSecurityToken[]
  claimedStudentRegistration    StudentRegistrationEligibility?
  studentProfile                StudentProfile?
  lecturerProfile               LecturerProfile?
  departmentMemberships         DepartmentMembership[]
  notifications                 Notification[]
  auditLogs                     AuditLog[]                     @relation("AuditActor")
  reportComments                ReportComment[]                @relation("ReportCommentAuthor")
  reportAssignments             ReportAssignment[]             @relation("ReportAssignmentActor")
  reportStatusChanges           ReportStatusHistory[]          @relation("ReportStatusActor")
  createdAssessments            Assessment[]                   @relation("AssessmentCreator")
  uploadedEvidence              SpecialCaseEvidence[]          @relation("EvidenceUploader")
  updatedSettings               SystemSetting[]                @relation("SettingUpdater")
  attendanceDiscrepancyComments AttendanceDiscrepancyComment[]
  submittedAttendanceDiscrepancies AttendanceDiscrepancy[] @relation("DiscrepancyReporter")
  attendanceDiscrepancyDecisions AttendanceDiscrepancyDecision[]
  reviewedMarkCorrections       MarkCorrection[]               @relation("MarkCorrectionReviewer")
  reportEligibilities           ReportEligibility[]
  designatedDepartments         Department[]                  @relation("DepartmentDesignatedCOD")
  appealDecisions                Appeal[]                      @relation("AppealDecisionActor")
  specialCaseSubmissions         SpecialCase[]                 @relation("SpecialCaseSubmitter")
  departmentMembershipRequests  DepartmentMembershipRequest[] @relation("DepartmentMembershipRequestLecturer")
  reviewedDepartmentMembershipRequests DepartmentMembershipRequest[] @relation("DepartmentMembershipRequestReviewer")
  specialCaseDecisions            SpecialCase[]                 @relation("SpecialCaseDecisionActor")
  managedSpecialCaseCategories  SpecialCaseCategory[]         @relation("SpecialCaseCategoryManager")
  managedPublicHolidays         PublicHoliday[]               @relation("PublicHolidayManager")
  administeredAttendanceCorrections AttendanceCorrection[] @relation("AdminAttendanceCorrectionActor")
  reviewedEnrollmentRequests       StudentEnrollmentRequest[] @relation("EnrollmentRequestReviewer")

  @@map("users")
}

model AccountLoginIdentifier {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  type      LoginIdentifierType
  value     String               @unique
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("account_login_identifiers")
}

model AccountSecurityToken {
  id        String                    @id @default(uuid()) @db.Uuid
  userId    String                    @map("user_id") @db.Uuid
  type      AccountSecurityTokenType
  tokenHash String                    @unique @map("token_hash")
  expiresAt DateTime                  @map("expires_at")
  usedAt    DateTime?                 @map("used_at")
  createdAt DateTime                  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@map("account_security_tokens")
}

model StudentRegistrationEligibility {
  id           String   @id @default(uuid()) @db.Uuid
  studentNumber String  @unique @map("student_number")
  email        String
  linkedUserId String?  @unique @map("linked_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  linkedUser User? @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("student_registration_eligibility")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model StudentProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  studentNumber     String   @unique @map("student_number")
  officialEmail     String?  @map("official_email")
  notificationEmail String?  @map("notification_email")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user                    User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollments             UnitEnrollment[]
  enrollmentRequests      StudentEnrollmentRequest[]
  reports                 MissingMarkReport[]
  appeals                 Appeal[]
  attendance              AttendanceRecord[]
  attendanceHistory       AttendanceHistory[]
  attendanceAttempts      AttendanceAttempt[]
  assessmentAttendances   AssessmentAttendance[]
  catSubmissions          CatSubmission[]
  attendanceDiscrepancies AttendanceDiscrepancy[]
  excuseRequests          AttendanceExcuseRequest[]

  @@map("student_profiles")
}

model LecturerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  staffNumber String?  @unique @map("staff_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                      User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  unitAssignments           CourseUnitLecturer[]
  assignedReports           MissingMarkReport[]       @relation("AssignedLecturer")
  attendanceSessions        AttendanceSession[]
  verifiedCatSubmissions    CatSubmission[]           @relation("CatVerifier")
  attendanceCorrections     AttendanceCorrection[]    @relation("CorrectionActor")
  assignedDiscrepancies     AttendanceDiscrepancy[]   @relation("DiscrepancyReviewer")
  reviewedDiscrepancies     AttendanceDiscrepancy[]   @relation("DiscrepancyLecturerReviewer")
  previousReportAssignments ReportAssignment[]        @relation("PreviousReportLecturer")
  newReportAssignments      ReportAssignment[]        @relation("NewReportLecturer")
  proposedMarkCorrections   MarkCorrection[]          @relation("MarkCorrectionProposer")
  reviewedExcuseRequests    AttendanceExcuseRequest[] @relation("ExcuseReviewer")

  @@map("lecturer_profiles")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String?  @unique
  initials  String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  courses     Course[]
  courseUnits CourseUnit[]
  members     DepartmentMembership[]
  membershipRequests DepartmentMembershipRequest[]
  designatedCodUserId String? @map("designated_cod_user_id") @db.Uuid
  designatedCod User? @relation("DepartmentDesignatedCOD", fields: [designatedCodUserId], references: [id], onDelete: SetNull)

  @@map("departments")
  @@index([designatedCodUserId])
}

model DepartmentMembership {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@map("department_memberships")
}

model Course {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  code         String   @db.VarChar(2)
  name         String   @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  courseUnits CourseUnit[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@map("courses")
}

model CourseUnit {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  courseId     String?  @map("course_id") @db.Uuid
  code         String
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department         Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  course             Course?              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollments        UnitEnrollment[]
  enrollmentRequests StudentEnrollmentRequest[]
  lecturerMappings   CourseUnitLecturer[]
  reports            MissingMarkReport[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]

  @@unique([departmentId, code])
  @@index([courseId])
  @@index([code])
  @@map("course_units")
}

model AcademicPeriod {
  id        String    @id @default(uuid()) @db.Uuid
  code      String?   @unique
  name      String
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  enrollmentOpensAt DateTime? @map("enrollment_opens_at")
  enrollmentClosesAt DateTime? @map("enrollment_closes_at")
  createdAt DateTime  @default(now()) @map("created_at")

  enrollments UnitEnrollment[]
  reports     MissingMarkReport[]
  enrollmentRequests StudentEnrollmentRequest[]

  @@index([name])
  @@map("academic_periods")
}

model DepartmentMembershipRequest {
  id                 String                              @id @default(uuid()) @db.Uuid
  lecturerUserId     String                              @map("lecturer_user_id") @db.Uuid
  departmentId       String                              @map("department_id") @db.Uuid
  status             DepartmentMembershipRequestStatus  @default(PENDING)
  reviewedByUserId   String?                             @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime?                           @map("reviewed_at")
  createdAt          DateTime                            @default(now()) @map("created_at")
  updatedAt          DateTime                            @updatedAt @map("updated_at")

  lecturer   User        @relation("DepartmentMembershipRequestLecturer", fields: [lecturerUserId], references: [id], onDelete: Cascade)
  department Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reviewedBy User?       @relation("DepartmentMembershipRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([lecturerUserId, departmentId])
  @@index([departmentId, status, createdAt])
  @@index([reviewedByUserId, reviewedAt])
  @@map("department_membership_requests")
}

model UnitEnrollment {
  id               String   @id @default(uuid()) @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  courseUnitId     String   @map("course_unit_id") @db.Uuid
  academicPeriodId String   @map("academic_period_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  student        StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  courseUnit     CourseUnit     @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, courseUnitId, academicPeriodId])
  @@index([courseUnitId, academicPeriodId])
  @@map("unit_enrollments")
}

model StudentEnrollmentRequest {
  id                 String                        @id @default(uuid()) @db.Uuid
  studentProfileId   String                        @map("student_profile_id") @db.Uuid
  courseUnitId       String                        @map("course_unit_id") @db.Uuid
  academicPeriodId   String                        @map("academic_period_id") @db.Uuid
  status             StudentEnrollmentRequestStatus @default(PENDING)
  reviewedByUserId   String?                       @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime?                     @map("reviewed_at")
  decisionNote       String?                       @map("decision_note") @db.VarChar(1000)
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  student      StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  courseUnit   CourseUnit     @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  reviewedBy   User?          @relation("EnrollmentRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, courseUnitId, academicPeriodId])
  @@index([status, createdAt])
  @@index([courseUnitId, status])
  @@index([reviewedByUserId, reviewedAt])
  @@map("student_enrollment_requests")
}

model CourseUnitLecturer {
  id                String   @id @default(uuid()) @db.Uuid
  courseUnitId      String   @map("course_unit_id") @db.Uuid
  lecturerProfileId String   @map("lecturer_profile_id") @db.Uuid
  academicYear      String?  @map("academic_year") @db.VarChar(7)
  createdAt         DateTime @default(now()) @map("created_at")

  courseUnit CourseUnit      @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  lecturer   LecturerProfile @relation(fields: [lecturerProfileId], references: [id], onDelete: Restrict)

  @@unique([courseUnitId, academicYear])
  @@index([lecturerProfileId])
  @@map("course_unit_lecturers")
}

model MissingMarkReport {
  id                        String    @id @default(uuid()) @db.Uuid
  reference                 String    @unique
  studentProfileId          String    @map("student_profile_id") @db.Uuid
  courseUnitId              String    @map("course_unit_id") @db.Uuid
  academicPeriodId          String    @map("academic_period_id") @db.Uuid
  assessmentId              String?   @map("assessment_id") @db.Uuid
  assessmentTypeId          String?   @map("assessment_type_id") @db.Uuid
  assessmentTypeOtherDescription String? @map("assessment_type_other_description")
  assignedLecturerProfileId String?   @map("assigned_lecturer_profile_id") @db.Uuid
  assessmentComponent       String    @map("assessment_component")
  description               String
  status                    String
  submittedAt               DateTime? @map("submitted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  student           StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  courseUnit        CourseUnit            @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  academicPeriod    AcademicPeriod        @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  assignedLecturer  LecturerProfile?      @relation("AssignedLecturer", fields: [assignedLecturerProfileId], references: [id], onDelete: Restrict)
  appeals           Appeal[]
  assessment        Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  assessmentType    AssessmentType?        @relation(fields: [assessmentTypeId], references: [id], onDelete: Restrict)
  comments          ReportComment[]
  assignments       ReportAssignment[]
  statusHistory     ReportStatusHistory[]
  specialCases      SpecialCase[]
  attendanceDiscrepancies AttendanceDiscrepancy[]
  evidence          SpecialCaseEvidence[]
  notifications     Notification[]
  eligibilityChecks ReportEligibility[]
  markCorrections   MarkCorrection[]

  @@index([studentProfileId, status])
  @@index([assignedLecturerProfileId, status])
  @@index([courseUnitId, academicPeriodId])
  @@index([assessmentId])
  @@index([assessmentTypeId])
  @@map("missing_mark_reports")
}

model AttendanceSession {
  id                String    @id @default(uuid()) @db.Uuid
  courseUnitId      String    @map("course_unit_id") @db.Uuid
  lecturerProfileId String    @map("lecturer_profile_id") @db.Uuid
  classroomId       String?   @map("classroom_id") @db.Uuid
  assessmentId      String?   @map("assessment_id") @db.Uuid
  sessionType String @default("CLASS") @map("session_type")
  accessTokenHash   String?   @unique @map("access_token_hash")
  status            String    @default("scheduled")
  startsAt          DateTime  @map("starts_at")
  endsAt            DateTime? @map("ends_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  courseUnit CourseUnit          @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  lecturer   LecturerProfile     @relation(fields: [lecturerProfileId], references: [id], onDelete: Restrict)
  records    AttendanceRecord[]
  classroom  Classroom?          @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  assessment Assessment?         @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  attempts   AttendanceAttempt[]

  @@index([courseUnitId, startsAt])
  @@index([lecturerProfileId])
  @@index([assessmentId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  status           String
  locationVerified Boolean  @default(false) @map("location_verified")
  recordedAt       DateTime @default(now()) @map("recorded_at")
  createdAt        DateTime @default(now()) @map("created_at")

  session        AttendanceSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student        StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  history        AttendanceHistory?
  corrections    AttendanceCorrection[]
  discrepancies  AttendanceDiscrepancy[]
  excuseRequests AttendanceExcuseRequest[]

  @@unique([sessionId, studentProfileId])
  @@index([studentProfileId, recordedAt])
  @@map("attendance_records")
}

model Appeal {
  id               String   @id @default(uuid()) @db.Uuid
  reportId         String   @unique @map("report_id") @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  reason           String
  status           String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  comments         String?
  decisionByUserId String?  @map("decision_by_user_id") @db.Uuid
  decisionAt       DateTime? @map("decision_at")
  decisionReason   String?  @map("decision_reason")
  reviewDeadlineAt DateTime? @map("review_deadline_at")

  report   MissingMarkReport     @relation(fields: [reportId], references: [id], onDelete: Restrict)
  student  StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  evidence SpecialCaseEvidence[]
  decisionBy User? @relation("AppealDecisionActor", fields: [decisionByUserId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([studentProfileId])
  @@index([status, reviewDeadlineAt])
  @@map("appeals")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  reportId  String?   @map("report_id") @db.Uuid
  title     String
  message   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  dedupeKey String?   @unique @map("dedupe_key")

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  report MissingMarkReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([reportId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Assessment {
  id                     String    @id @default(uuid()) @db.Uuid
  courseUnitId           String    @map("course_unit_id") @db.Uuid
  createdByUserId        String?   @map("created_by_user_id") @db.Uuid
  code                   String?
  name                   String
  type                   String
  assessmentDate         DateTime? @map("assessment_date")
  maximumMarks           Decimal?  @map("maximum_marks") @db.Decimal(8, 2)
  requiredForEligibility Boolean   @default(false) @map("required_for_eligibility")
  attendanceRequired     Boolean   @default(false) @map("attendance_required")
  submissionRequired     Boolean   @default(false) @map("submission_required")
  qrReferenceHash        String?   @unique @map("qr_reference_hash")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  courseUnit        CourseUnit             @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  createdBy         User?                  @relation("AssessmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reports           MissingMarkReport[]
  sessions          AttendanceSession[]
  attendanceRecords AssessmentAttendance[]
  catSubmissions    CatSubmission[]

  @@unique([courseUnitId, code])
  @@index([courseUnitId, type])
  @@map("assessments")
}

model AssessmentType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reports MissingMarkReport[]

  @@map("assessment_types")
}

model Classroom {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  boundaryMeters Int      @map("boundary_meters")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sessions AttendanceSession[]

  @@unique([name])
  @@map("classrooms")
}

model AttendanceAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  outcome          String
  failureReason    String?  @map("failure_reason")
  occurredAt       DateTime @default(now()) @map("occurred_at")

  session       AttendanceSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student       StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  discrepancies AttendanceDiscrepancy[]

  @@index([sessionId, occurredAt])
  @@index([studentProfileId, occurredAt])
  @@map("attendance_attempts")
}

model AttendanceHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  attendanceRecordId String?  @unique @map("attendance_record_id") @db.Uuid
  studentProfileId   String   @map("student_profile_id") @db.Uuid
  courseUnitCode     String   @map("course_unit_code")
  courseUnitName     String   @map("course_unit_name")
  sessionStartedAt   DateTime @map("session_started_at")
  status             String
  locationVerified   Boolean  @map("location_verified")
  signedAt           DateTime @map("signed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  student          StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@index([studentProfileId, signedAt])
  @@map("attendance_history")
}

model AttendanceCorrection {
  id                 String   @id @default(uuid()) @db.Uuid
  attendanceRecordId String   @map("attendance_record_id") @db.Uuid
  lecturerProfileId  String?  @map("lecturer_profile_id") @db.Uuid
  administratorUserId String? @map("administrator_user_id") @db.Uuid
  discrepancyDecisionId String? @unique @map("discrepancy_decision_id") @db.Uuid
  originalStatus     String   @map("original_status")

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missing_marks?schema=public
# Neon direct URL (direct endpoint). Use this only for Prisma migration CLI jobs.
DIRECT_DATABASE_URL=
# Neon pooled runtime URL (pooler endpoint). Optional if DATABASE_URL is already pooled.
DATABASE_POOL_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_SEED_PASSWORD=replace-with-strong-demo-password-123!
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
# Set only to the verified number of trusted reverse-proxy hops; never trust client-supplied forwarding headers.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_IP_MAX=1200
API_RATE_LIMIT_USER_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_IP_MAX=120
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
REGISTRATION_RATE_LIMIT_MAX=5
RECOVERY_RATE_LIMIT_WINDOW_MS=900000
RECOVERY_RATE_LIMIT_MAX=5
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=20
RESOURCE_RATE_LIMIT_WINDOW_MS=900000
RESOURCE_RATE_LIMIT_MAX=30
COOKIE_SAME_SITE=lax
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test
BOOTSTRAP_ADMIN_NUMBER=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Backend development configuration. Copy this file to backend/.env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Create the missing_marks database first. Replace the username and password
# with your local PostgreSQL credentials; URL-encode special characters.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missing_marks_db?schema=public
DIRECT_DATABASE_URL=
DATABASE_POOL_URL=

# Use a private random value of at least 32 characters. Do not commit backend/.env.
JWT_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
COOKIE_SAME_SITE=lax

# Development-only Mailpit settings. Start Mailpit with the email-testing
# Compose profile before sending email. For a backend in Compose, use mailpit.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Missing Marks System <no-reply@missingmarks.local>"

# Optional local demo seed and one-time administrator bootstrap settings.
DEMO_SEED_PASSWORD=replace-with-strong-demo-password-123!
BOOTSTRAP_ADMIN_NUMBER=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

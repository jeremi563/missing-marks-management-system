# Backend development configuration. Copy this file to backend/.env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Create the missing_marks database first. Replace the username and password
# with your local PostgreSQL credentials; URL-encode special characters.
DATABASE_URL=postgresql://postgres:Hani@2005@localhost:5432/missing_marks_db?schema=public

# Use a private random value of at least 32 characters. Do not commit backend/.env.
JWT_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:5173

# Optional SMTP settings; email verification and password recovery require these.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test

# Optional local demo seed and one-time administrator bootstrap settings.
DEMO_SEED_PASSWORD=replace-with-strong-demo-password-123!
BOOTSTRAP_ADMIN_NUMBER=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
